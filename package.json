{
  "name": "midgardlauncher",
  "version": "2.21.8",
  "private": true,
  "description": "Launcher oficial do servidor Midgard",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/patch-download-engine.js && node scripts/patch-java-options.js && node scripts/patch-mojang-timeout.js && node scripts/install-hooks.js",
    "protect": "node scripts/protect-assets.js",
    "validate": "node scripts/validate-distribution.js",
    "validate:fix": "node scripts/validate-distribution.js --fix",
    "validate:remote": "node scripts/validate-distribution.js --remote",
    "predist": "npm run validate:fix && npm run protect",
    "dist": "electron-builder --win",
    "dist:publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@electron/remote": "2.1.2",
    "adm-zip": "0.5.10",
    "discord-rpc-patch": "4.0.1",
    "ejs-electron": "3.0.0",
    "electron-updater": "^6.8.3",
    "github-syntax-dark": "^0.5.0",
    "got": "11.8.6",
    "helios-core": "2.2.0",
    "helios-distribution-types": "1.3.0",
    "jquery": "^3.7.1",
    "lodash.merge": "4.6.2",
    "semver": "7.6.0",
    "toml": "3.0.0"
  },
  "devDependencies": {
    "electron": "29.1.0",
    "electron-builder": "24.13.3"
  }
}
